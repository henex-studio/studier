{
  "_comment": "Template for .claude/settings.json. Cowork cannot write into .claude/ because settings.json can register hooks that execute commands, which is a privilege escalation path. Copy this file into place from your terminal with: mkdir -p .claude && cp harness-docs/claude-settings.template.json .claude/settings.json",

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/guard-paths.sh"
          }
        ]
      }
    ]
  },

  "permissions": {
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase db reset:*)",
      "Read(./.env)",
      "Read(./.env.local)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(npm install:*)",
      "Bash(supabase:*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(npm run build:*)",
      "Bash(bash scripts/:*)"
    ]
  }
}
